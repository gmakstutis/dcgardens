{{ include('@b5_dcg/includes/site_record_node_header.twig') }}
<div class="container mt-4">
  <div class="row fs-4 mb-2">
    <div class="col">
      <span class="fw-bold">Date: </span>{{ node.field_arrival.date|date('Y-m-d') }} - {{ node.field_arrival.date|date('H:i') }}
    </div>
    <div class="col">
    {% if node.field_site_location.entity.title.value == "~Other..." %}
      <span class="fw-bold">Site: </span>{{ node.field_site_location_other.value }}
    {% else %}
      <span class="fw-bold">Site: </span>{{ node.field_site_location.entity.title.value }}
    {% endif %}
    </div>
  </div>
  <div class="row mb-2">
    <div class="col fs-4">
      <span class="fw-bold">Operatives on site: </span>{{ node.field_operatives.value }}
    </div>
    <div class="col">
      <div class="fs-4"><span class="fw-bold">Works: </span></div>
      {% for work in node.field_works %}
        <span class="badge rounded-pill text-bg-info">{{ work.entity.title.value }}</span>
      {% endfor %}
      {% if node.field_other_works.value %}
        {% set others = node.field_other_works.value|split(',') %}
        {% for other in others %}
          <span class="badge rounded-pill text-bg-secondary">{{ other }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  <div class="row">
    <div class="col">
      <div class="fs-4"><span class="fw-bold">Work Notes: </span></div>
        {{ node.field_description.value | raw }}
      </div>
    </div>
  </div>
  <div class="row mt-4">
    <div class="col">
      <div class="fs-4"><span class="fw-bold">Site Photo(s): </span></div>
    </div>
  </div>
  <div class="row">
    {% for item in content.field_site_photos['#items'] %}
      {% set photo_url = file_url(item.entity.uri.value) %}
      {% set mid = 'photo-' ~ node.id() ~ '-' ~ loop.index0 %}
      <div class="col-3 my-1">
      <a href="#" data-bs-toggle="modal" data-bs-target="#{{ mid }}">
        {{ content.field_site_photos[loop.index0] }}
      </a>
      </div>
      <div class="modal fade" id="{{ mid }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
              <img src="{{ photo_url }}" alt="{{ node.label }}" class="img-fluid" />
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
