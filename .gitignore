# CSS/JS asset caches generated by Drupal
web/sites/*/files/css
web/sites/*/files/js

# Aggregated asset cache directories
web/sites/*/files/php

# Other generated cache directories
web/sites/*/files/styles
web/sites/*/files/translations
web/sites/*/files/sync

# Temporary files
web/sites/*/files/tmp
web/sites/*/files/temporary

# DDEV-generated local settings (keep settings.php, ignore DDEV-specific)
web/sites/*/settings.ddev.php

# OS/editor cruft
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/